{
  "name": "obsidian-chord-import",
  "version": "0.1.0",
  "description": "Import songs from chord websites (Ultimate Guitar) into your Obsidian vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "node tests/build.mjs && node --test tests/.tmp/"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "chords",
    "worship"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  }
}
